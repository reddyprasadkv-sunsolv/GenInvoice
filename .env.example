# Django Core Settings
DJANGO_SECRET_KEY=change-this-local-secret-before-real-use
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Database Configuration (Defaults to SQLite if unset; configure DATABASE_URL for PostgreSQL)
# DATABASE_URL=postgres://invoiceuser:securepassword@localhost:5432/invoicedb
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=invoicedb
# DJANGO_DB_USER=invoiceuser
# DJANGO_DB_PASSWORD=securepassword
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Production Security SSL Settings (Used when DJANGO_DEBUG=0)
# SECURE_SSL_REDIRECT=1
# SECURE_COOKIE_SECURITY=1
# SECURE_PROXY_SSL_HEADER=1
# SECURE_HSTS_SECONDS=31536000
