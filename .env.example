# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION (Defaults apply if environment variables unset)
# ==============================================================================
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-local-only-phase-1-change-before-shared-use
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Database Configuration (Defaults to SQLite if unset)
# DATABASE_URL=postgres://invoiceuser:securepassword@localhost:5432/invoicedb?sslmode=require
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=invoicedb
# DJANGO_DB_USER=invoiceuser
# DJANGO_DB_PASSWORD=securepassword
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60
# DJANGO_DB_SSLMODE=require

# ==============================================================================
# PRODUCTION ENVIRONMENT HARDENING (Set DJANGO_DEBUG=0 for production mode)
# ==============================================================================
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=MUST_BE_PROVIDED_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
# DJANGO_ALLOWED_HOSTS=invoice.example.com,www.invoice.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://invoice.example.com,https://www.invoice.example.com
#
# Production Security Settings (Defaults to True when DJANGO_DEBUG=0)
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# SECURE_SSL_REDIRECT=1
# SECURE_CONTENT_TYPE_NOSNIFF=1
# SECURE_REFERRER_POLICY=same-origin
#
# Reverse Proxy Header (Enable ONLY behind trusted reverse proxy like Nginx/Cloudflare)
# SECURE_PROXY_SSL_HEADER=1
#
# Conservative HSTS Settings (Enable only after verifying HTTPS deployment)
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SECURE_HSTS_PRELOAD=0
